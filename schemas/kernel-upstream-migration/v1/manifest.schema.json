{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Interested-Deving-1896/btrfs-dwarfs-framework/blob/main/schemas/kernel-upstream-migration/v1/manifest.schema.json",
  "title": "Kernel Upstream Migration and Backport Manifest",
  "description": "Provider-neutral, auditable plan and evidence record for forward migrations and controlled stable/LTS backports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "migration_id",
    "provider",
    "kernel_line",
    "source",
    "target",
    "operation",
    "changes",
    "policy",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "migration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "liqxanmod",
        "liquorix-unified-kernel",
        "xanmod-unified-kernel",
        "other"
      ]
    },
    "kernel_line": {
      "type": "string",
      "enum": [
        "mainline",
        "stable",
        "lts",
        "vendor-maintained",
        "legacy-eol"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "operation": {
      "type": "string",
      "enum": [
        "forward-migration",
        "backport",
        "mixed",
        "audit-only"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      },
      "minItems": 1
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dry_run",
        "human_approval_required",
        "protected_branch_write"
      ],
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "human_approval_required": {
          "type": "boolean",
          "const": true
        },
        "protected_branch_write": {
          "type": "boolean",
          "const": false
        },
        "security_fixes_first": {
          "type": "boolean",
          "default": true
        },
        "allow_eol_target": {
          "type": "boolean",
          "default": false
        },
        "approval_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "blocked",
        "ready-for-isolated-apply",
        "applied-unvalidated",
        "validated",
        "rejected",
        "published"
      ]
    },
    "report": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "report_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "report_uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "url",
        "ref",
        "commit",
        "kernel_version"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40,64}$"
        },
        "kernel_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref",
        "kernel_version",
        "architectures"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "kernel_version": {
          "type": "string",
          "minLength": 1
        },
        "architectures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "config_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "upstream_commit",
        "classification",
        "subsystem",
        "license",
        "risk",
        "dependencies"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "minLength": 1
        },
        "upstream_commit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{7,64}$"
        },
        "upstream_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "classification": {
          "type": "string",
          "enum": [
            "clean-forward-port",
            "clean-backport",
            "context-adjusted-backport",
            "semantic-manual-port",
            "not-applicable",
            "blocked",
            "rejected"
          ]
        },
        "subsystem": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "critical",
            "unknown"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "affected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "affected_symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "kconfig": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "abi_impact": {
          "type": "string",
          "enum": [
            "none-known",
            "internal",
            "userspace-facing",
            "module-abi",
            "unknown"
          ],
          "default": "unknown"
        },
        "decision_reason": {
          "type": "string"
        },
        "approval_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "state"
      ],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "unavailable",
            "not-applicable",
            "unknown"
          ]
        },
        "architecture": {
          "type": [
            "string",
            "null"
          ]
        },
        "toolchain": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "details": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "passed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "evidence_uri"
            ],
            "properties": {
              "evidence_uri": {
                "type": "string",
                "format": "uri",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
